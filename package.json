{
	"name": "crypt-unix",
	"version": "0.2.0",
	"description": "A Node.JS implementation of the Unix/Linux crypt(3) call.",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "tsc --emitDeclarationOnly && rollup -c",
		"test": "jest --coverage",
		"prepublish": "npm test"
	},
	"engines": {
		"node": ">16"
	},
	"files": [
		"dist/**"
	],
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/GregJArnold/crypt-unix.git"
	},
	"keywords": [
		"unix",
		"crypt",
		"linux",
		"shadow"
	],
	"author": "Greg J. Arnold",
	"license": "BSD-3-Clause",
	"bugs": {
		"url": "https://github.com/GregJArnold/crypt-unix/issues"
	},
	"homepage": "https://github.com/GregJArnold/crypt-unix#readme",
	"devDependencies": {
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/jest": "^29.5.12",
		"@types/node": "^20.14.11",
		"jest": "^29.7.0",
		"rollup": "^4.62.4",
		"ts-jest": "^29.2.3",
		"tslib": "^2.8.1",
		"typescript": "^5.5.3"
	}
}
